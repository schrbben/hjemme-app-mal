# Kopier til .env.local for å kjøre appen lokalt. Verdiene legges også inn i Vercel.

# Fra Supabase (Claude kan hente dem med Supabase-koblingen).
# Bruk den nye publishable-nøkkelen (sb_publishable_…). Den gamle anon-nøkkelen
# (NEXT_PUBLIC_SUPABASE_ANON_KEY, begynner med eyJ) virker også, men fases ut ved slutten av 2026.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Varsler for Rydding. Lag med: npx web-push generate-vapid-keys
# Den private nøkkelen skal aldri deles eller skrives ut.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
